---
import HeroArt from './HeroArt.astro';
interface Props {}
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow" data-reveal style="--d:60ms">Сервис форм</p>
      <h1 id="hero-title" data-reveal style="--d:100ms">Создавайте формы онлайн</h1>
      <p class="additional-name" data-reveal style="--d:160ms">Опросы и тесты в одном месте</p>
      <p class="lead" data-reveal style="--d:220ms">Чтобы создать форму, войдите в личный кабинет.</p>
      <div id="auth-controls" class="auth-controls" data-state="loading" data-reveal style="--d:300ms">
        <button type="button" id="auth-btn" class="btn when-guest">
          Войти через nmchv
          <svg class="arrow-right" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <span id="user-role" class="user-role when-user"></span>
        <a href="/cabinet" class="btn btn-ghost btn-sm when-user">Личный кабинет</a>
        <button type="button" id="logout-btn" class="btn btn-ghost btn-sm when-user">Выйти</button>
      </div>
    </div>
    <div class="hero-art-col" data-reveal style="--d:200ms">
      <HeroArt />
    </div>
  </div>
</section>
