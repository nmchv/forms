---
import ThemeToggle from './ThemeToggle.astro';
interface Props {}
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const current = (href: string): 'page' | undefined => (path === href ? 'page' : undefined);
---
<header class="site-header" id="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="Формы — главная">
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 20 L12 3 L20 20 M7.2 14.5 H16.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
      </svg>
      <span class="brand-name">Формы</span>
    </a>
    <div class="header-actions">
      <nav class="nav" aria-label="Основная навигация">
        <a href="/" data-nav="home" aria-current={current('/')}>Главная</a>
        <a href="/create" data-nav="create" aria-current={current('/create')} hidden>Создать</a>
        <a href="https://nmchv.ru" target="_blank" rel="noopener noreferrer" data-nav="main">Основной сайт</a>
        <a href="https://www.login.nmchv.ru" target="_blank" rel="noopener noreferrer" data-nav="cabinet">Личный кабинет</a>
      </nav>
      <ThemeToggle lang="ru" />
    </div>
  </div>
</header>

<script>
  import { supabase } from '../lib/supabase';
  import { getSSOUser, signOutSSO, initiateSSO } from '../lib/sso';

  const controls = document.getElementById('auth-controls');
  const authBtn = document.getElementById('auth-btn');
  const logoutBtn = document.getElementById('logout-btn');
  const userRoleEl = document.getElementById('user-role');
  const createLink = document.querySelector<HTMLElement>('a[data-nav="create"]');

  const roleLabels: Record<string, string> = {
    admin: 'Суперадмин',
    tutor: 'Учитель',
    student: 'Ученик',
  };

  function setCreateVisible(visible: boolean) {
    if (!createLink) return;
    const wasHidden = createLink.hidden;
    createLink.hidden = !visible;
    if (visible && wasHidden) createLink.classList.add('is-shown');
  }

  async function initAuth() {
    let user = null;
    try {
      user = await getSSOUser();
    } catch {
      user = null;
    }

    if (user) {
      if (userRoleEl) userRoleEl.textContent = roleLabels[user.role] ?? 'Ученик';
      setCreateVisible(user.role !== 'student');
    } else {
      setCreateVisible(false);
    }
    controls?.setAttribute('data-state', user ? 'user' : 'guest');
  }

  authBtn?.addEventListener('click', () => {
    initiateSSO(document.referrer || '/');
  });

  logoutBtn?.addEventListener('click', async () => {
    await signOutSSO();
  });

  supabase.auth.onAuthStateChange(() => {
    initAuth();
  });

  initAuth();
</script>
