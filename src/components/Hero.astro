---
interface Props {}
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow" data-reveal style="--d:60ms">Сервис форм</p>
      <h1 id="hero-title" data-reveal style="--d:100ms">Создавайте формы онлайн</h1>
      <p class="additional-name" data-reveal style="--d:160ms">Опросы и тесты в одном месте</p>
      <p class="lead" data-reveal style="--d:220ms">Чтобы создать форму, войдите в личный кабинет.</p>
      <div id="auth-controls" class="auth-controls" data-reveal style="--d:300ms">
        <button type="button" id="auth-btn" class="btn-login">Войти через nmchv</button>
        <button type="button" id="logout-btn" class="btn-login" style="display:none;">Выйти</button>
        <span id="user-role" class="user-role" style="display:none;"></span>
      </div>
    </div>
  </div>
</section>
