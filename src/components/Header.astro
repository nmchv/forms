---
import ThemeToggle from './ThemeToggle.astro';
interface Props {}
---
<header class="site-header" id="site-header">
  <div class="container">
    <a class="brand" href="#top" aria-label="Формы — главная">
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 20 L12 3 L20 20 M7.2 14.5 H16.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
      </svg>
      <span class="brand-name">Формы</span>
    </a>
    <div class="header-actions">
      <nav class="nav" aria-label="Основная навигация">
        <a href="#top" data-nav="home">Главная</a>
        <a href="#create" data-nav="create">Создать</a>
        <a href="https://nmchv.ru" target="_blank" rel="noopener noreferrer" data-nav="main">Основной сайт</a>
        <a href="#cabinet" data-nav="cabinet">Личный кабинет</a>
      </nav>
      <ThemeToggle lang="ru" />
      <div id="auth-controls" class="auth-controls" style="display:none;">
        <button type="button" id="auth-btn" class="btn-login">Войти</button>
        <button type="button" id="logout-btn" class="btn-login" style="display:none;">Выйти</button>
        <span id="user-role" class="user-role" style="display:none;"></span>
      </div>
    </div>
  </div>
</header>

<script>
  import { supabase } from '../lib/supabase';
  import { getCurrentUser, signOut } from '../lib/auth';

  const authBtn = document.getElementById('auth-btn');
  const logoutBtn = document.getElementById('logout-btn');
  const userRoleEl = document.getElementById('user-role');
  const authControls = document.getElementById('auth-controls');
  const createLink = document.querySelector('a[data-nav="create"]') as HTMLElement | null;

  async function initAuth() {
    const user = await getCurrentUser();
    const isAuthed = !!user;

    authControls?.style.setProperty('display', 'flex');

    if (isAuthed) {
      authBtn?.style.setProperty('display', 'none');
      logoutBtn?.style.setProperty('display', 'inline-flex');
      userRoleEl?.style.setProperty('display', 'inline-block');
      userRoleEl.textContent = user.role === 'admin' ? 'Суперадмин' : (user.role === 'tutor' ? 'Учитель' : 'Ученик');

      // Создание форм — только tutor и admin
      if (user.role === 'student') {
        createLink?.style.setProperty('display', 'none');
      } else {
        createLink?.style.setProperty('display', 'inline-flex');
      }
    } else {
      authBtn?.style.setProperty('display', 'inline-flex');
      logoutBtn?.style.setProperty('display', 'none');
      userRoleEl?.style.setProperty('display', 'none');
      createLink?.style.setProperty('display', 'none');
    }
  }

  authBtn?.addEventListener('click', async () => {
    const email = prompt('Введите ваш email для входа:');
    if (!email) return;
    const { error } = await supabase.auth.signInWithOtp({ email });
    if (error) {
      alert('Ошибка: ' + error.message);
      return;
    }
    alert('Код подтверждения отправлен на ' + email + '. Проверьте почту.');
    initAuth();
  });

  logoutBtn?.addEventListener('click', async () => {
    await signOut();
    initAuth();
  });

  // Слушаем изменения сессии
  supabase.auth.onAuthStateChange(() => {
    initAuth();
  });

  initAuth();
</script>
