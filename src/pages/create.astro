---
import Layout from '../layouts/Base.astro';
---
<Layout title="Создать форму | Формы">
  <div class="page page-split">
    <div class="page-head" data-reveal>
      <p class="eyebrow">Конструктор</p>
      <h1>Создать форму</h1>
      <p>Переходите на страницу создания форм.</p>
    </div>

    <div class="auth-card" data-reveal style="--d:120ms">
      <div class="loading-row"><span class="spinner" aria-hidden="true"></span><p>Перенаправляем на страницу создания форм…</p></div>
      <div class="auth-actions" style="margin-top:24px">
        <a href="/forms" class="btn">Перейти к созданию формы</a>
      </div>
    </div>
  </div>

  <script>
    window.location.replace('/forms');
  </script>
</Layout>
