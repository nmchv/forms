---
import Layout from '../layouts/Base.astro';
---
<Layout>
  <div class="page">
    <div class="page-head">
      <h1>Вход в личный кабинет</h1>
      <p>Войдите, чтобы управлять формами и просматривать результаты.</p>
    </div>

    <div class="auth-card">
      <h2>Войти</h2>
      <form class="auth-form" id="login-form">
        <div class="auth-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required placeholder="you@example.com" />
        </div>
        <div class="auth-actions">
          <button type="submit" class="btn">Получить код входа</button>
        </div>
      </form>

      <div class="auth-divider">или</div>

      <div class="auth-actions">
        <button type="button" class="btn btn-primary" id="google-btn">Войти через Google</button>
      </div>

      <div class="auth-footer">
        Нет аккаунта? <a href="/cabinet">Создать профиль</a>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const googleBtn = document.getElementById('google-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.email.value;
      const { error } = await supabase.auth.signInWithOtp({ email });
      if (error) {
        alert('Ошибка: ' + error.message);
        return;
      }
      alert('Код подтверждения отправлен на ' + email + '. Проверьте почту.');
    });

    googleBtn?.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: `${location.origin}/cabinet` } });
      if (error) alert('Ошибка Google-входа: ' + error.message);
    });
  </script>
</Layout>
