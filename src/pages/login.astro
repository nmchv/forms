---
import Layout from '../layouts/Base.astro';
---
<Layout>
  <div class="page">
    <div class="page-head">
      <h1>Вход в личный кабинет</h1>
      <p>Войдите, чтобы управлять формами и просматривать результаты.</p>
    </div>

    <div class="auth-card">
      <h2>Войти через nmchv</h2>
      <button type="button" class="btn btn-primary" id="sso-btn">Войти через nmchv</button>

      <div class="auth-divider">или</div>

      <h2>Войти по email</h2>
      <form class="auth-form" id="login-form">
        <div class="auth-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required placeholder="you@example.com" />
        </div>
        <div class="auth-actions">
          <button type="submit" class="btn">Получить код входа</button>
        </div>
      </form>

      <div class="auth-footer">
        Нет аккаунта? <a href="/cabinet">Создать профиль</a>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { initiateSSO } from '../lib/sso';

    const ssoBtn = document.getElementById('sso-btn');
    const form = document.getElementById('login-form') as HTMLFormElement;

    ssoBtn?.addEventListener('click', async () => {
      const returnTo = document.referrer || '/';
      initiateSSO(returnTo);
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.email.value;
      const { error } = await supabase.auth.signInWithOtp({ email });
      if (error) {
        alert('Ошибка: ' + error.message);
        return;
      }
      alert('Код подтверждения отправлен на ' + email + '. Проверьте почту.');
    });
  </script>
</Layout>
