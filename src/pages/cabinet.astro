---
import Layout from '../layouts/Base.astro';
---
<Layout>
  <div class="page">
    <div class="page-head">
      <h1>Личный кабинет</h1>
      <p>Ваш профиль, роли и формы.</p>
    </div>

    <div class="auth-card">
      <h2 id="cabinet-title">Загрузка профиля…</h2>
      <div id="cabinet-content" style="display:none;">
        <div class="auth-field">
          <label>Роль</label>
          <input type="text" id="role-display" readonly class="field-input" />
        </div>
        <div class="auth-field">
          <label>Email</label>
          <input type="email" id="email-display" readonly class="field-input" />
        </div>
        <div class="auth-field">
          <label>Имя пользователя</label>
          <input type="text" id="username-display" readonly class="field-input" />
        </div>
        <div class="auth-actions">
          <button type="button" class="btn" id="logout-btn">Выйти</button>
        </div>
      </div>
      <div id="cabinet-not-authed" style="display:none;">
        <p>Вы не вошли в аккаунт.</p>
        <a href="/login" class="btn">Войти</a>
      </div>
    </div>
  </div>

  <script>
    import { getCurrentUser, signOut } from '../lib/auth';

    const title = document.getElementById('cabinet-title');
    const content = document.getElementById('cabinet-content');
    const notAuthed = document.getElementById('cabinet-not-authed');
    const roleDisplay = document.getElementById('role-display') as HTMLInputElement;
    const emailDisplay = document.getElementById('email-display') as HTMLInputElement;
    const usernameDisplay = document.getElementById('username-display') as HTMLInputElement;
    const logoutBtn = document.getElementById('logout-btn');

    const roleLabels = { student: 'Ученик', tutor: 'Учитель', admin: 'Суперадмин' };

    async function load() {
      const user = await getCurrentUser();
      if (!user) {
        notAuthed.style.display = 'block';
        content.style.display = 'none';
        title.textContent = 'Личный кабинет';
        return;
      }

      notAuthed.style.display = 'none';
      content.style.display = 'block';
      title.textContent = 'Личный кабинет — ' + roleLabels[user.role];
      roleDisplay.value = roleLabels[user.role];
      emailDisplay.value = user.email ?? '—';
      usernameDisplay.value = user.username ?? '—';
    }

    logoutBtn?.addEventListener('click', async () => {
      await signOut();
      load();
    });

    load();
  </script>
</Layout>
