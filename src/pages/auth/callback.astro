---
import Layout from '../../layouts/Base.astro';
---
<Layout title="Авторизация | Формы">
  <div class="page page-split">
    <div class="page-head" data-reveal>
      <p class="eyebrow">Единый вход</p>
      <h1>Авторизация через nmchv</h1>
      <p id="callback-status" role="status" aria-live="polite">Обработка ответа от центральной системы…</p>
    </div>

    <div class="auth-card" data-reveal style="--d:120ms">
      <div class="state-block" id="callback-content">
        <div class="loading-row"><span class="spinner" aria-hidden="true"></span><p>Перенаправление на страницу, с которой вы начали вход…</p></div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { getReturnTo } from '../../lib/sso';

    const CALLBACK_HOST = 'www.forms.nmchv.ru';
    const status = document.getElementById('callback-status') as HTMLElement;
    const content = document.getElementById('callback-content') as HTMLElement;

    function fail(title: string, message: string) {
      status.textContent = title;
      content.replaceChildren();
      const p = document.createElement('p');
      p.textContent = message;
      const a = document.createElement('a');
      a.href = '/login';
      a.className = 'btn';
      a.textContent = 'Попробовать снова';
      content.append(p, a);
    }

    (function canonicalize() {
      if (location.hostname === 'forms.nmchv.ru') {
        location.replace(`https://${CALLBACK_HOST}${location.pathname}${location.search}${location.hash}`);
      }
    })();

    async function handleCallback() {
      try {
        const params = new URLSearchParams(window.location.search);
        const errorParam = params.get('error');
        const errorDescription = params.get('error_description');

        if (errorParam) {
          fail('Ошибка авторизации', errorDescription || 'Целевая система вернула ошибку входа.');
          return;
        }

        const accessToken = params.get('access_token');
        const refreshToken = params.get('refresh_token');

        if (!accessToken || !refreshToken) {
          const { data: { session } } = await supabase.auth.getSession();
          if (session?.user) {
            window.location.replace(getReturnTo('/'));
            return;
          }
          fail('Токены сессии не получены.', 'Не удалось установить сессию. Пожалуйста, попробуйте войти ещё раз.');
          return;
        }

        history.replaceState(null, document.title, window.location.pathname);

        const { data, error } = await supabase.auth.setSession({
          access_token: accessToken,
          refresh_token: refreshToken,
        });

        if (error || !data.session?.user) {
          fail('Не удалось установить сессию на формы.', error?.message || 'Сессия не валидна.');
          return;
        }

        const { data: { user }, error: userError } = await supabase.auth.getUser();
        if (userError || !user || user.id !== data.session.user.id) {
          fail('Сессия не прошла проверку.', 'Попробуйте войти ещё раз.');
          return;
        }

        status.textContent = `Вход выполнен. Перенаправление…`;
        const returnTo = getReturnTo('/');
        window.location.replace(returnTo);
      } catch (err) {
        fail('Ошибка при обработке авторизации.', err instanceof Error ? err.message : String(err));
      }
    }

    handleCallback();
  </script>
</Layout>
