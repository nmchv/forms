---
import Layout from '../../layouts/Base.astro';
---
<Layout>
  <div class="page">
    <div class="page-head">
      <h1>Авторизация через nmchv</h1>
      <p id="callback-status">Обработка ответа от центральной системы…</p>
    </div>

    <div class="auth-card">
      <div id="callback-content">
        <p>Перенаправление на страницу, с которой вы начали вход…</p>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { getReturnTo } from '../../lib/sso';

    async function handleCallback() {
      const status = document.getElementById('callback-status');
      const content = document.getElementById('callback-content');

      try {
        const params = new URLSearchParams(window.location.search);
        const accessToken = params.get('access_token');
        const refreshToken = params.get('refresh_token');

        if (!accessToken || !refreshToken) {
          status.textContent = 'Токены сессии не получены.';
          content.innerHTML = `
            <p>Не удалось установить сессию. Пожалуйста, попробуйте войти ещё раз.</p>
            <button class="btn" onclick="window.location.href='/login'">Войти ponownie</button>
          `;
          return;
        }

        // Устанавливаем сессию Supabase на домене forms
        const { data, error } = await supabase.auth.setSession({
          access_token: accessToken,
          refresh_token: refreshToken,
        });

        if (error || !data.session?.user) {
          status.textContent = 'Не удалось установить сессию на формы.';
          content.innerHTML = `
            <p>${error?.message || 'Сессия не валидна.'}</p>
            <button class="btn" onclick="window.location.href='/login'">Попробовать снова</button>
          `;
          return;
        }

        const user = data.session.user;
        status.textContent = `Вход выполнен как ${user.email}. Перенаправление…`;
        content.innerHTML = `<p>Перенаправление…</p>`;

        const returnTo = getReturnTo('/');
        setTimeout(() => {
          window.location.href = returnTo;
        }, 800);
      } catch (err) {
        status.textContent = 'Ошибка при обработке авторизации.';
        content.innerHTML = `
          <p>${err.message}</p>
          <button class="btn" onclick="window.location.href='/login'">Попробовать снова</button>
        `;
      }
    }

    handleCallback();
  </script>
</Layout>
